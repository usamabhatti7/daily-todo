{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily To-Do",
  "version": "1.2.0",
  "identifier": "com.usama.dailytodo",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      { "title": "Daily To-Do", "width": 520, "height": 820, "minWidth": 380, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
