{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily To-Do",
  "version": "1.7.0",
  "identifier": "com.usama.dailytodo",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "Daily To-Do",
        "width": 520,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "UB Labs",
    "copyright": "Copyright (c) 2026 Usama Bhatti, trading as UB Labs. All rights reserved.",
    "shortDescription": "Daily to-do list tracker"
  }
}
